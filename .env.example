# Copy to /opt/frigate/.env on the Frigate LXC — never commit real .env
#
# If a password contains $, quote it so Docker Compose does not treat
# it as variable expansion:
#   FRIGATE_RTSP_PASSWORD='$WetherillCam$'
#   FRIGATE_MQTT_PASSWORD='$1900Scott$'

FRIGATE_RTSP_PASSWORD=changeme
FRIGATE_MQTT_PASSWORD=changeme
